# Vorlage: cp .env.example .env, dann Werte eintragen. .env nie committen.
# Werte OHNE Anführungszeichen und ohne Leerzeichen nach dem "=".

POSTGRES_PASSWORD=hier-ein-langes-zufallspasswort

# Embeddings (derzeit OpenAI). Das Modell muss 1536 Dimensionen liefern
# (Schema vector(1536)). EMBED_BASE_URL / EMBED_API_KEY leer = NEXOS_*.
EMBED_BASE_URL=https://api.openai.com/v1
EMBED_API_KEY=
EMBED_MODEL=text-embedding-3-small

# Chat (derzeit OpenAI). Modellnamen vorher mit GET /v1/models prüfen.
# CHAT_BASE_URL / CHAT_API_KEY leer = NEXOS_*.
CHAT_BASE_URL=https://api.openai.com/v1
CHAT_API_KEY=
CHAT_MODEL=gpt-5.4-nano

# Rückfall (nexos.ai, OpenAI-kompatibel). Wird nur benutzt, wenn oben
# BASE_URL bzw. API_KEY leer sind. Modellnamen bei nexos enthalten
# Leerzeichen, z.B. EMBED_MODEL=Text Embedding 3 Small.
NEXOS_BASE_URL=https://api.nexos.ai/v1
NEXOS_API_KEY=

MAX_CHUNK_CHARS=2000
MATCH_COUNT=8
EXCLUDE_LAYERS=betrieb
