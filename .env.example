# Vorlage: cp .env.example .env, dann Werte eintragen. .env nie committen.
# Werte OHNE Anführungszeichen, auch wenn Modell-IDs Leerzeichen enthalten.

POSTGRES_PASSWORD=hier-ein-langes-zufallspasswort

# Standard-Zugang (nexos.ai, OpenAI-kompatibel). Gilt für Embeddings und Chat,
# solange unten nichts anderes eingetragen ist.
NEXOS_BASE_URL=https://api.nexos.ai/v1
NEXOS_API_KEY=

# Embeddings. EMBED_BASE_URL / EMBED_API_KEY leer = NEXOS_* wird benutzt.
# Das Modell muss 1536 Dimensionen liefern (Schema vector(1536)).
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=Text Embedding 3 Small

# Chat. CHAT_BASE_URL / CHAT_API_KEY leer = NEXOS_* wird benutzt.
CHAT_BASE_URL=
CHAT_API_KEY=
CHAT_MODEL=Claude Sonnet 4.6

MAX_CHUNK_CHARS=2000
MATCH_COUNT=8
EXCLUDE_LAYERS=betrieb
